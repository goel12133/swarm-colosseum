# Copy to .house_league.env (gitignored) and fill in. The nightly cron job sources it.
# Without ANTHROPIC_API_KEY the night aborts cleanly with a log line and exit code 2.
export ANTHROPIC_API_KEY="sk-ant-..."

# Hard caps. The night aborts BEFORE any API call if a call could take it past one.
export HOUSE_LEAGUE_MAX_USD=2.00
export HOUSE_LEAGUE_MAX_TOKENS=200000
export HOUSE_LEAGUE_MAX_CALLS=4
export HOUSE_LEAGUE_BOTS=2
export HOUSE_LEAGUE_MODEL=claude-opus-5
