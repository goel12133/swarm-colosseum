# Copy to .house_league.env (gitignored) and edit. The nightly cron job sources it.
# Every line is optional; the defaults are shown.

# cli: the Claude Code CLI on this box (`claude -p`), on the subscription login. No key.
# api: the Anthropic SDK; needs ANTHROPIC_API_KEY and uses the dollar cap below.
export HOUSE_LEAGUE_BACKEND=cli

# Hard caps, checked BEFORE the call: a night that could go past one aborts and calls nothing.
export HOUSE_LEAGUE_MAX_TOKENS=200000
export HOUSE_LEAGUE_MAX_CALLS=4
export HOUSE_LEAGUE_BOTS=2

# Model: a CLI alias (opus, sonnet) on cli; a full model id on api (default claude-opus-5).
# export HOUSE_LEAGUE_MODEL=opus
# export HOUSE_LEAGUE_CLI_TIMEOUT=900        # seconds before the CLI call is killed
# export HOUSE_LEAGUE_CLAUDE_BIN=/root/.local/bin/claude

# api backend only:
# export ANTHROPIC_API_KEY="sk-ant-..."
# export HOUSE_LEAGUE_MAX_USD=2.00
